# Copy this to .env and fill in your values
# Never commit .env to version control
#
# On Railway these go in: service → Variables (do not upload the .env file
# itself unless you use Railway's "Raw Editor" import).

# ── Google OAuth2 (for app login) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ── Allowlisted email (only this account can sign in via Google) ──────────────
ALLOWED_EMAIL=your.email@gmail.com

# ── Cookie signing secret — generate with: openssl rand -hex 32 ──────────────
SECRET_KEY=generate_with__openssl_rand_-hex_32

# ── Public domain ─────────────────────────────────────────────────────────────
# Must match the OAuth redirect URI registered in Google Cloud Console
# (APP_BASE_URL + /auth/callback), with no trailing slash.
# On Railway this is optional: if unset, the app uses the service's
# RAILWAY_PUBLIC_DOMAIN. Set it explicitly once you attach a custom domain.
APP_BASE_URL=https://your-app.up.railway.app

# ── Google Gemini API key (for OCR) ──────────────────────────────────────────
# Get this from https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ── Gemini model (optional) ───────────────────────────────────────────────────
# Overrides ocr.model_name in config.yaml, so the model can be swapped from
# the host's variables UI (Railway: service → Variables) with no code change.
# Leave unset to use config.yaml (currently gemini-3.5-flash-lite).
# Higher accuracy / higher quota cost: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# ── Poe API (optional — only relevant if ocr.engine is "poe" in config.yaml) ──
# Alternative OCR engine that calls a vision-capable bot on Poe instead of
# Gemini directly. Prefer entering these on the running app's Settings page
# instead (sign in → Settings) — no redeploy needed, and it takes priority
# over these env vars. Set them here only if you'd rather manage Poe
# credentials the same way as GEMINI_API_KEY (host Variables UI), or want a
# fallback default for when the Settings page fields are left blank.
# Get a key at https://poe.com/api_key
# POE_API_KEY=your_poe_api_key_here

# ── Poe bot / model (optional — see note above) ───────────────────────────────
# Overrides ocr.poe_model_name in config.yaml. Poe has no default model —
# this must name a vision-capable bot available in your Poe account.
# Confirm the exact name at https://poe.com; the value below is an example,
# not a guaranteed-current bot name.
# POE_MODEL=Claude-Sonnet-4.5

# ── Writable data directory (optional) ───────────────────────────────────────
# Parent of uploads/, outputs/ and tmp-work/. Defaults to the app directory
# (/app in the container), which is EPHEMERAL on Railway — every redeploy
# wipes it. Attach a Railway volume and set this to its mount path to keep
# uploaded sources and generated PDFs across deploys.
# DATA_DIR=/data

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave blank (or omit) to use in-process storage — no Redis service needed,
# but job state is lost on restart.
# On Railway: add a Redis database to the project, then set this to the
# reference variable ${{Redis.REDIS_URL}}.
# REDIS_URL=redis://localhost:6379

# ── Port (optional) ───────────────────────────────────────────────────────────
# Injected automatically by Railway. Only set this for local runs.
# PORT=8080
