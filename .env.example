# Copy this to .env and fill in your values
# Never commit .env to version control
#
# On Railway these go in: service → Variables (do not upload the .env file
# itself unless you use Railway's "Raw Editor" import).

# ── Google OAuth2 (for app login) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ── Allowlisted email (only this account can sign in via Google) ──────────────
ALLOWED_EMAIL=your.email@gmail.com

# ── Cookie signing secret — generate with: openssl rand -hex 32 ──────────────
SECRET_KEY=generate_with__openssl_rand_-hex_32

# ── Public domain (optional) ──────────────────────────────────────────────────
# Must match the OAuth redirect URI registered in Google Cloud Console
# (APP_BASE_URL + /auth/callback), with no trailing slash.
# On Railway, leave this UNSET — the app auto-detects the service's real
# RAILWAY_PUBLIC_DOMAIN. Only set it once you attach a custom domain, and set
# it to that domain exactly (copy-pasting the line below as-is will break
# login — the app will now refuse to boot if you do, but don't rely on that).
# APP_BASE_URL=https://your-actual-domain.example.com

# ── Google Gemini API key (for OCR) ──────────────────────────────────────────
# Get this from https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ── Writable data directory (optional) ───────────────────────────────────────
# Parent of uploads/, outputs/ and tmp-work/. Defaults to the app directory
# (/app in the container), which is EPHEMERAL on Railway — every redeploy
# wipes it. Attach a Railway volume and set this to its mount path to keep
# uploaded sources and generated PDFs across deploys.
# DATA_DIR=/data

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave blank (or omit) to use in-process storage — no Redis service needed,
# but job state is lost on restart.
# On Railway: add a Redis database to the project, then set this to the
# reference variable ${{Redis.REDIS_URL}}.
# REDIS_URL=redis://localhost:6379

# ── Port (optional) ───────────────────────────────────────────────────────────
# Injected automatically by Railway. Only set this for local runs.
# PORT=8080
